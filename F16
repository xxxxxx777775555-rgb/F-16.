-- ===== อาวุธบนเครื่อง =====
local function ordKind(inst)
	local s = (inst.Name .. " " .. (inst.Parent and inst.Parent.Name or "")):lower()
	if s:find("aim") or s:find("sidewinder") or s:find("amraam") then return "aam" end
	if s:find("agm") or s:find("maverick") then return "agm" end
	return "bomb"
end

local function addOrd(inst, model, kind)
	if ordUnitSet[inst] or partCount(inst) == 0 then return end
	ordUnitSet[inst] = true
	for _, p in ipairs(partsOf(inst)) do
		ordPartSet[p] = true
		removeGear(p)
		removeDoor(p)
	end
	local rel = model:GetPivot():ToObjectSpace(inst:GetPivot())
	table.insert(ordList, {
		inst = inst, rel = rel, tmpl = inst:Clone(), kind = kind or ordKind(inst),
		lat = (rel.Position - centerOff):Dot(latAxis()), fid = inst:GetAttribute("fid"),
	})
end

local function kindTotal(kind)
	local n = 0
	for _, o in ipairs(ordList) do
		if o.kind == kind then n += 1 end
	end
	return n
end

local function leftOf(kind)
	if kindTotal(kind) == 0 then return fallback[kind] or 0 end
	local n = 0
	for _, o in ipairs(ordList) do
		if o.kind == kind and o.inst and o.inst.Parent then n += 1 end
	end
	return n
end

local function rearmOrd(pivotCF)
	for _, o in ipairs(ordList) do
		if not (o.inst and o.inst.Parent) then
			local n = o.tmpl:Clone()
			n.Parent = jet
			n:PivotTo(pivotCF * o.rel)
			o.inst = n
		end
	end
end

local function buildCandidates(model, canopy)
	local parts = {}
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then table.insert(parts, p) end
	end
	local pv = model:GetPivot()
	local ref = canopy and canopy.Position or pv.Position

	local byNear = table.clone(parts)
	table.sort(byNear, function(a, b) return (a.Position - ref).Magnitude < (b.Position - ref).Magnitude end)
	candNear = {}
	for _, p in ipairs(byNear) do
		if p ~= canopy then
			table.insert(candNear, p)
			if #candNear >= 40 then break end
		end
	end

	local byLow = table.clone(parts)
	table.sort(byLow, function(a, b)
		return pv:PointToObjectSpace(a.Position).Y < pv:PointToObjectSpace(b.Position).Y
	end)
	candLow = {}
	for i = 1, math.min(40, #byLow) do candLow[i] = byLow[i] end
	cycIdx = {near = 0, low = 0}
end

-- ซ่อนกระจกครอบและชิ้นเล็กที่ติดกล้องในมุมบุคคลที่ 1 (กันภาพแตก)
local function resetNearHide()
	for p in pairs(hiddenNear) do
		if p.Parent then p.LocalTransparencyModifier = 0 end
		hiddenNear[p] = nil
	end
end

local function updateNearHide(eye, on)
	if not on then
		if next(hiddenNear) then resetNearHide() end
		return
	end
	if os.clock() < nextHide then return end
	nextHide = os.clock() + 0.15
	for _, p in ipairs(jetParts) do
		if p.Parent and not gearSet[p] then
			local glass = p.Material == Enum.Material.Glass or (p.Transparency > 0.15 and p.Transparency < 0.98)
				or wordIn(p.Name, {"canopy", "glass", "windshield"})
			local near = p.Size.Magnitude < jetDiag * 0.2 and (p.Position - eye).Magnitude < 6
			if glass or near then
				p.LocalTransparencyModifier = 1
				hiddenNear[p] = true
			elseif hiddenNear[p] then
				p.LocalTransparencyModifier = 0
				hiddenNear[p] = nil
			end
		end
	end
end

-- ===== โหลดโมเดล =====
local function loadJet()
	local ok, result = pcall(function() return game:GetObjects("rbxassetid://" .. ASSET_ID) end)
	if not ok or not result or #result == 0 then
		warn("โหลดโมเดลไม่ได้ / model load failed:", result)
		return nil
	end
	local model = result[1]
	if not model:IsA("Model") then
		local m = Instance.new("Model")
		model.Parent = m
		model = m
	end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
		end
	end
	model.Name = "F16_Local"
	model.Parent = workspace
	pcall(function() model.WorldPivot = model:GetPivot() end)

	local fidMap = {}
	for n, d in ipairs(model:GetDescendants()) do
		d:SetAttribute("fid", n)
		fidMap[n] = d
	end

	table.clear(cntCache)
	gearParts, gearSet, doorParts, doorSet = {}, {}, {}, {}
	ordList, ordUnitSet, ordPartSet = {}, {}, {}
	gearUp, gearAnim, lastS, lastEd = false, 0, 0, 0
	selected = nil
	for _, h in ipairs(gearHL) do h:Destroy() end
	gearHL = {}
	hiddenNear = {}
	gunAmmo, fallback = GUN_MAX, table.clone(FALLBACK_AMMO)

	local total = #partsOf(model)
	local cap = math.max(8, total * 0.25)
	local capOrd = math.max(6, total * 0.12)
	local _, bb0 = model:GetBoundingBox()
	local diag = bb0.Magnitude
	jetDiag = diag

	-- ลบบันได / สีม่วง / ลูกกลมดำ / ชิ้นที่เลือกไว้
	local removed, purple, dark = 0, 0, 0
	local purplePos = {}
	for _, id in ipairs(REMOVE_IDS) do
		local inst = fidMap[id]
		if inst and inst.Parent then inst:Destroy() removed += 1 end
	end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Parent then
			if p.Size.Magnitude < diag * 0.45 and nameHit(p, model, LADDER_WORDS, cap) then
				p:Destroy()
				removed += 1
			elseif REMOVE_PURPLE and p.Size.Magnitude < diag * 0.12 then
				local h, s = p.Color:ToHSV()
				if s > 0.3 and h > 0.72 and h < 0.86 then
					table.insert(purplePos, p.Position)
					p:Destroy()
					purple += 1
				end
			end
		end
	end
	if REMOVE_DARK_BALL then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p.Parent and p.Size.Magnitude < diag * 0.1
				and not wordIn(p.Name, GEAR_WORDS) and not wordIn(p.Name, ORD_WORDS) and not wordIn(p.Name, DOOR_WORDS) then
				local _, _, v = p.Color:ToHSV()
				local s3 = p.Size
				local mx, mn = math.max(s3.X, s3.Y, s3.Z), math.min(s3.X, s3.Y, s3.Z)
				local ball = (p:IsA("Part") and p.Shape == Enum.PartType.Ball) or (p:IsA("MeshPart") and mn > mx * 0.85)
				local nearPurple = false
				for _, pp in ipairs(purplePos) do
					if (pp - p.Position).Magnitude < diag * 0.1 then nearPurple = true break end
				end
				if v < 0.22 and (ball or nearPurple) then
					p:Destroy()
					dark += 1
				end
			end
		end
	end
	table.clear(cntCache)

	-- ปรับการเรนเดอร์ให้ภาพไม่แตก/ไม่ขาด
	jetParts = partsOf(model)
	for _, p in ipairs(jetParts) do
		p.CastShadow = false
		if PRECISE_MESH and p:IsA("MeshPart") then
			pcall(function() p.RenderFidelity = Enum.RenderFidelity.Precise end)
		end
	end

	-- ตัวเครื่อง + ห้องนักบิน
	local pv = model:GetPivot()
	local bbCF, bbSize = model:GetBoundingBox()
	centerOff = pv:PointToObjectSpace(bbCF.Position)
	jetSizeY = bbSize.Y
	gearH = math.max(bbSize.Y * 0.5 + GEAR_ADJUST, 3)
	jetDiag = bbSize.Magnitude

	local yaw, seat, partName, f, canopy = calibrate(model)
	if yaw then
		yawOff, seatBase = yaw, seat
		fwdAxis = f
		print(("[F16] canopy '%s' | yaw=%d"):format(partName, yaw))
	else
		yawOff, seatBase = FALLBACK_YAW, FALLBACK_SEAT
		local r = math.rad(FALLBACK_YAW)
		fwdAxis = Vector3.new(math.round(math.sin(r)), 0, -math.round(math.cos(r)))
		warn("[F16] canopy not found, using fallback (use SEAT/TILT in MENU)")
	end

	-- อาวุธบนเครื่อง
	local manualOrd = (#BOMB_IDS + #AGM_IDS + #AAM_IDS) > 0
	for _, pair in ipairs({{BOMB_IDS, "bomb"}, {AGM_IDS, "agm"}, {AAM_IDS, "aam"}}) do
		for _, id in ipairs(pair[1]) do
			local inst = fidMap[id]
			if inst and inst.Parent then addOrd(inst, model, pair[2]) end
		end
	end
	if not manualOrd then
		local units = {}
		for _, d in ipairs(model:GetDescendants()) do
			if (d:IsA("BasePart") or d:IsA("Model") or d:IsA("Folder")) and wordIn(d.Name, ORD_WORDS) and partCount(d) > 0 then
				if partCount(d) <= capOrd then
					units[d] = true
				else
					for _, c in ipairs(d:GetChildren()) do
						if partCount(c) > 0 and partCount(c) <= capOrd then units[c] = true end
					end
				end
			end
		end
		for u in pairs(units) do
			local x = u.Parent
			while x and x ~= model do
				if units[x] then units[u] = nil break end
				x = x.Parent
			end
		end
		for u in pairs(units) do addOrd(u, model) end
	end

	-- ฝาช่องล้อ แล้วล้อ
	local lowY = centerOff.Y
	local function isLow(p) return pv:PointToObjectSpace(p.Position).Y < lowY end
	for _, id in ipairs(DOOR_IDS) do
		local inst = fidMap[id]
		if inst and inst:IsA("BasePart") and inst.Parent then addDoor(inst, model, false) end
	end
	if #DOOR_IDS == 0 then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p.Size.Magnitude < diag * 0.45 and isLow(p)
				and nameHit(p, model, DOOR_WORDS, cap) and not nameHit(p, model, {"canopy", "cockpit", "glass"}, cap) then
				addDoor(p, model, false)
			end
		end
	end
	for _, id in ipairs(GEAR_IDS) do
		local inst = fidMap[id]
		if inst and inst:IsA("BasePart") and inst.Parent then addGear(inst, model) end
	end
	if #GEAR_IDS == 0 then
		local autoGear = {}
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p.Size.Magnitude < diag * 0.45 and isLow(p) and nameHit(p, model, GEAR_WORDS, cap) then
				table.insert(autoGear, p)
			end
		end
		if #autoGear > total * 0.3 then
			warn("[F16] too many gear matches by name, auto-gear cancelled (use MENU > LOW > +GEAR)")
		else
			for _, p in ipairs(autoGear) do addGear(p, model) end
		end
	end
	rebuildClusters()

	print(("[F16] removed %d | purple %d | dark %d | gear %d | doors %d | weapons %d | gearH %.2f"):format(
		removed, purple, dark, #gearParts, #doorParts, #ordList, gearH))

	buildCandidates(model, canopy)
	ui()
	return model
end

