	if hrp then
		hrp.Anchored = false
		local pos = jetPos + ctrl:VectorToWorldSpace(Vector3.new(14, 2, 0))
		hrp.CFrame = CFrame.lookAt(pos, Vector3.new(jetPos.X, pos.Y, jetPos.Z))
	end
	hudText.Text = tr("parked_msg")
