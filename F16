local function wpnText()
	if weapon == 1 then return ("%s %s %03d"):format(tr("w_gun"), ammoType, gunAmmo) end
	return ("%s %02d"):format(tr(WKEY[weapon]), leftOf(KIND[weapon]))
end

-- ===== คีย์บอร์ด + หมุนกล้อง =====
UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	keys[i.KeyCode] = true
	if i.KeyCode == Enum.KeyCode.C then
		toggleCam()
	elseif i.KeyCode == Enum.KeyCode.F and engineOn then
		setAB(not ab)
	elseif i.KeyCode == Enum.KeyCode.B then
		onFireDown()
	elseif i.KeyCode == Enum.KeyCode.V then
		cycleWeapon()
	elseif i.KeyCode == Enum.KeyCode.N then
		cycleSub()
	elseif i.KeyCode == Enum.KeyCode.X and flying then
		setEngine(not engineOn)
	elseif i.KeyCode == Enum.KeyCode.G then
		brake = not brake
		ui()
	elseif i.KeyCode == Enum.KeyCode.L then
		toggleGear()
	end
end)
UIS.InputEnded:Connect(function(i)
	keys[i.KeyCode] = false
	if i.KeyCode == Enum.KeyCode.B then firing = false end
end)

UIS.InputChanged:Connect(function(i, gp)
	if gp or not flying then return end
	if i.UserInputType == Enum.UserInputType.MouseWheel then
		camDist = math.clamp(camDist - i.Position.Z * 5, 5, 250)
		return
	end
	local rightDrag = i.UserInputType == Enum.UserInputType.MouseMovement and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	if rightDrag or i.UserInputType == Enum.UserInputType.Touch then
		camYaw = camYaw - i.Delta.X * 0.4
		camPitch = math.clamp(camPitch - i.Delta.Y * 0.4, -80, 80)
	end
end)

-- ===== ลูปหลัก =====
RunService.RenderStepped:Connect(function(dt)
	if not flying then return end
	dt = math.min(dt, 0.05)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not jet or not jet.Parent or not hrp then stopFlying() return end

	local prevY, wasGround = jetPos.Y, onGround

	local function key(...)
		for _, k in ipairs({...}) do
			if keys[k] then return 1 end
		end
		return 0
	end
	local pT = math.clamp(key(Enum.KeyCode.W, Enum.KeyCode.Up) - key(Enum.KeyCode.S, Enum.KeyCode.Down)
		+ (hold.up and 1 or 0) - (hold.down and 1 or 0), -1, 1)
	local rT = math.clamp(key(Enum.KeyCode.E) - key(Enum.KeyCode.Q)
		+ (hold.rr and 1 or 0) - (hold.rl and 1 or 0), -1, 1)
	local yT = math.clamp(key(Enum.KeyCode.D, Enum.KeyCode.Right) - key(Enum.KeyCode.A, Enum.KeyCode.Left)
		+ (hold.yr and 1 or 0) - (hold.yl and 1 or 0), -1, 1)
	local kbT = key(Enum.KeyCode.LeftShift) - key(Enum.KeyCode.LeftControl)
	if kbT ~= 0 then
		throttle = math.clamp(throttle + kbT * 0.5 * dt, 0, 1)
		showThrottle()
	end
	local a = 1 - math.exp(-6 * dt)
	pitchIn += (pT - pitchIn) * a
	rollIn += (rT - rollIn) * a
	yawIn += (yT - yawIn) * a

	-- เครื่องยนต์ / ความเร็ว / เบรก
	local target = engineOn and (throttle * MAX_SPEED * (ab and AB_MULT or 1)) or 0
	local k = 0.9
	if target > speed and onGround then
		k = 0.4
	elseif target < speed then
		if onGround then k = brake and 4 or 0.6 else k = engineOn and 0.5 or 0.12 end
	end
	speed += (target - speed) * math.min(1, dt * k)
	if onGround and brake then speed = math.max(0, speed - 70 * dt) end
	if speed < 0.5 and target < 1 then speed = 0 end

	-- ล้อ: ลงพื้นตอนล้อเก็บ ปล่อยล้อลงเอง
	if onGround and gearUp then
		gearUp = false
		say(tr("h_gear_auto"))
		ui()
	end
	local gTarget = gearUp and 1 or 0
	gearAnim += math.clamp(gTarget - gearAnim, -1.0 * dt, 1.0 * dt)

	-- การหมุนเครื่อง
	if onGround then
		local canRotate = speed >= ROTATE_SPEED
		local p = (canRotate and pitchIn > 0) and pitchIn or 0
		local taxi = -yawIn * 0.55 * math.clamp(speed / 25, 0, 1)
		ctrl = ctrl * CFrame.Angles(p * PITCH_RATE * dt, taxi * dt, 0)
		if p == 0 then
			local lk = ctrl.LookVector
			local fl = Vector3.new(lk.X, 0, lk.Z)
			if fl.Magnitude < 0.05 then fl = Vector3.new(0, 0, -1) end
			ctrl = ctrl:Lerp(CFrame.lookAt(Vector3.zero, fl.Unit), 1 - math.exp(-5 * dt))
		end
	else
		local bank = math.atan2(ctrl.RightVector.Y, ctrl.UpVector.Y)
		ctrl = ctrl * CFrame.Angles(pitchIn * PITCH_RATE * dt, -yawIn * YAW_RATE * dt + bank * BANK_TURN * dt, -rollIn * ROLL_RATE * dt)
	end
	jetPos += ctrl.LookVector * speed * dt

	-- stall
	if not onGround then
		local sink = math.clamp((STALL_SPEED - speed) / STALL_SPEED, 0, 1)
		if sink > 0 then
			jetPos += Vector3.new(0, -sink * 70 * dt, 0)
			ctrl = ctrl * CFrame.Angles(-sink * 0.6 * dt, 0, 0)
		end
	end

	-- พื้น
	onGround = false
	local hit = workspace:Raycast(jetPos, Vector3.new(0, -(gearH + 3), 0), rp)
	if hit and jetPos.Y - hit.Position.Y <= gearH + 0.3 then
		local lifting = speed >= ROTATE_SPEED and ctrl.LookVector.Y > 0.06
		if not lifting then
			onGround = true
			jetPos = Vector3.new(jetPos.X, hit.Position.Y + gearH, jetPos.Z)
		end
	end
	if onGround and not wasGround then
		local sinkRate = (prevY - jetPos.Y) / dt
		if sinkRate > 30 then shake = math.max(shake, math.clamp(sinkRate / 100, 0, 1.2)) end
	end

	-- วางโมเดล + ล้อ/ฝาช่องล้อ
	local jetCF = CFrame.new(jetPos) * ctrl.Rotation * CFrame.Angles(0, math.rad(yawOff), 0)
	local pivotCF = jetCF * CFrame.new(-centerOff)
	jet:PivotTo(pivotCF)
	applyGear(pivotCF)

	-- ปืนกล
	if firing and weapon == 1 and gunAmmo > 0 then
		gunAcc += dt * 100
		local n = math.min(math.floor(gunAcc), gunAmmo)
		if n > 0 then
			gunAcc -= n
			gunAmmo -= n
			fireGun(n)
		end
	elseif not firing then
		gunAcc = 0
	end

	-- เติมอาวุธเมื่อจอดนิ่ง ดับเครื่อง
	if onGround and speed < 1 and not engineOn then
		rearmTimer += dt
		if rearmTimer > 2.5 then
			rearmOrd(pivotCF)
			gunAmmo = GUN_MAX
			fallback = table.clone(FALLBACK_AMMO)
		end
	else
		rearmTimer = 0
	end

	-- นักบิน
	local seatWorld = pivotCF:PointToWorldSpace(seatBase) + ctrl:VectorToWorldSpace(seatNudge)
	hrp.CFrame = CFrame.new(seatWorld) * ctrl.Rotation * CFrame.Angles(math.rad(seatTilt), 0, 0)
	if hum then
		hum.Sit = true
		hum.AutoRotate = false
	end
	local first = camMode == "FIRST"
	local hideChar = first and 1 or 0
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.LocalTransparencyModifier = hideChar end
	end

	-- กล้อง: ใช้ขอบฟ้าโลกเป็นหลัก ตามทิศเครื่องแบบหน่วงนุ่ม ไม่ล็อคกับเครื่อง
	local rate = first and CAM_SMOOTH_FIRST or CAM_SMOOTH_FREE
	local ka = 1 - math.exp(-rate * dt)
	camLook = camLook:Lerp(ctrl.LookVector, ka)
	if camLook.Magnitude < 0.01 then camLook = ctrl.LookVector end
	camLook = camLook.Unit
	local rollFollow = first and CAM_ROLL_FIRST or CAM_ROLL_FREE
	local upTarget = Vector3.yAxis:Lerp(ctrl.UpVector, rollFollow)
	if upTarget.Magnitude < 0.01 then upTarget = ctrl.UpVector end
	camUpV = camUpV:Lerp(upTarget.Unit, ka).Unit
	local upUse = (math.abs(camLook:Dot(camUpV)) > 0.98) and ctrl.UpVector or camUpV
	local camBase = CFrame.lookAt(Vector3.zero, camLook, upUse)

	local eye = CFrame.new(seatWorld) * ctrl.Rotation * CFrame.new(0, 1.6, 0)
	if first then
		cam.CFrame = CFrame.new(eye.Position) * camBase.Rotation * CFrame.Angles(math.rad(camPitch), math.rad(camYaw), 0)
	else
		local rot = CFrame.new(jetPos) * camBase.Rotation * CFrame.Angles(0, math.rad(camYaw), 0) * CFrame.Angles(math.rad(camPitch), 0, 0)
		local camPos = (rot * CFrame.new(0, camHeight, camDist)).Position
		cam.CFrame = CFrame.lookAt(camPos, jetPos, camBase.UpVector)
	end
	updateNearHide(eye.Position, first)

	if firing and weapon == 1 then shake = math.max(shake, 0.03) end
	if shake > 0.01 then
		cam.CFrame *= CFrame.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
		shake *= (1 - math.min(1, dt * 4))
	end
	cam.FieldOfView += ((camFov + (ab and 8 or 0)) - cam.FieldOfView) * math.min(1, dt * 3)

	-- เสียงเครื่องยนต์
	local volT = engineOn and (0.5 + 1.0 * throttle) or 0
	local pitchT = engineOn and (0.75 + 0.5 * throttle + 0.3 * (speed / MAX_SPEED) + (ab and 0.15 or 0)) or 0.4
	engSnd.Volume += (volT - engSnd.Volume) * math.min(1, dt * 2.5)
	engSnd.PlaybackSpeed += (pitchT - engSnd.PlaybackSpeed) * math.min(1, dt * 2)

	-- HUD
	local look = ctrl.LookVector
	local hdg = math.deg(math.atan2(look.X, -look.Z)) % 360
	local state = ""
	if not engineOn then
		state = tr((onGround and speed < 1) and "st_parked" or "st_engoff")
	elseif onGround then
		state = tr("st_gnd")
	end
	if gearUp then state = state .. " " .. tr("st_gup") end
	hudText.Text = string.format("%s %03d  %s %04d  %s %03d  %s  %s",
		tr("spd"), speed * 1.94, tr("alt"), jetPos.Y, tr("hdg"), hdg, wpnText(), state)
	if os.clock() < hintUntil then hudText.Text = hint end

	horizon.Rotation = math.deg(math.atan2(ctrl.RightVector.Y, ctrl.UpVector.Y))
	horizon.Position = UDim2.new(0.5, 0, 0.5, math.deg(math.asin(math.clamp(look.Y, -1, 1))) * 3)

	local sp, onScreen = cam:WorldToViewportPoint(jetPos + ctrl.LookVector * 300)
	local inset = GuiService:GetGuiInset()
	cross.Visible = onScreen
	if onScreen then cross.Position = UDim2.fromOffset(sp.X - inset.X, sp.Y - inset.Y) end
end)

-- เริ่มต้น
hudText.Text = tr("standby")
ui()
print("[F16] script loaded OK")
