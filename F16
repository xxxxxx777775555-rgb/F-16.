function startFlying()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if jet and jet.Parent and not flying and (hrp.Position - jetPos).Magnitude < 80 then
		beginFlight(char, hrp, hum)
		return
	end

	if jet then stopFlying() end
	jet = loadJet()
	if not jet then return end
	rp.FilterDescendantsInstances = {jet, char}

	local look = hrp.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
	ctrl = CFrame.lookAt(Vector3.zero, flat.Unit)
	local sx = hrp.Position + flat.Unit * 45
	jetPos = sx + Vector3.new(0, 25, 0)
	speed, throttle = 120, 0.45
	setEngine(true)
	onGround = false

	if not SPAWN_IN_AIR then
		local h = workspace:Raycast(Vector3.new(sx.X, hrp.Position.Y + 10, sx.Z), Vector3.new(0, -400, 0), rp)
		if h then
			jetPos = Vector3.new(sx.X, h.Position.Y + gearH, sx.Z)
			speed, throttle = 0, 0
			setEngine(false)
			onGround = true
		end
	end
	showThrottle()
	seatNudge, seatTilt = Vector3.zero, 0
	beginFlight(char, hrp, hum)
end

