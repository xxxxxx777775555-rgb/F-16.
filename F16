local scales = {}
local function cluster(anchor, pos, w, h)
	local f = mk("Frame", {
		AnchorPoint = anchor, Position = pos, Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1,
	}, gui)
	table.insert(scales, mk("UIScale", {Scale = 1}, f))
	return f
end
local function rescale()
	local W, H = gui.AbsoluteSize.X, gui.AbsoluteSize.Y
	if W < 10 or H < 10 then return end
	local s = math.clamp(math.min((W - 16) / 840, H / 450), 0.5, 1)
	for _, u in ipairs(scales) do u.Scale = s end
end

