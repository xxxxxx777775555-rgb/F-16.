local function tracer(a, b)
	local diff = b - a
	if diff.Magnitude < 1 then return end
	local len = math.min(diff.Magnitude, 300)
	local dir = diff.Unit
	local mid = a + dir * (len / 2)
	local t = mk("Part", {
		Size = Vector3.new(0.2, 0.2, len), CFrame = CFrame.lookAt(mid, mid + dir), Anchored = true,
		CanCollide = false, CanQuery = false, CanTouch = false, Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 230, 120),
	}, fx)
	Debris:AddItem(t, 0.06)
end

local function gunHit(pos)
	local api = ammoType == "API"
	local s = mk("Part", {
		Shape = Enum.PartType.Ball, Size = Vector3.new(1.5, 1.5, 1.5), Position = pos, Anchored = true,
		CanCollide = false, CanQuery = false, CanTouch = false, Material = Enum.Material.Neon,
		Color = api and Color3.fromRGB(255, 110, 30) or Color3.fromRGB(255, 240, 180),
	}, fx)
	TweenService:Create(s, TweenInfo.new(0.25), {Size = Vector3.new(5, 5, 5), Transparency = 1}):Play()
	Debris:AddItem(s, 0.4)
	if not api and math.random() < 0.12 then
		local ex = Instance.new("Explosion")
		ex.Position, ex.BlastRadius, ex.BlastPressure, ex.DestroyJointRadiusPercent = pos, 4, 0, 0
		ex.ExplosionType = Enum.ExplosionType.NoCraters
		ex.Parent = workspace
	elseif api and math.random() < 0.1 then
		local fp = mk("Part", {
			Size = Vector3.one, Transparency = 1, Anchored = true, CanCollide = false, CanQuery = false,
			CanTouch = false, Position = pos,
		}, fx)
		mk("Fire", {Size = 4, Heat = 6}, fp)
		Debris:AddItem(fp, 1.5)
	end
end

local function fireGun(n)
	local muzzle = jetPos + ctrl:VectorToWorldSpace(Vector3.new(-1.6, 0.2, -7))
	tracerCount += n
	for _ = 1, math.min(n, 2) do
		local spread = 0.012
		local dir = (ctrl.LookVector + ctrl.RightVector * (math.random() - 0.5) * spread + ctrl.UpVector * (math.random() - 0.5) * spread).Unit
		local res = workspace:Raycast(muzzle, dir * 900, bombRP)
		local endPos = res and res.Position or (muzzle + dir * 900)
		if tracerCount >= 5 then
			tracerCount = 0
			tracer(muzzle, endPos)
		end
		if res then gunHit(res.Position) end
	end
end

-- ===== ระเบิด / AGM / AAM =====
local projectiles = {}

local function boresightPoint()
	local res = workspace:Raycast(jetPos, ctrl.LookVector * 5000, bombRP)
	return res and res.Position or nil
end

local function findTarget(sub)
	local range = sub == "AIM-120" and 4000 or 1500
	local cone = math.rad(sub == "AIM-120" and 45 or 25)
	local best, bestAng
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= player and pl.Character then
			local r = pl.Character:FindFirstChild("HumanoidRootPart")
			if r then
				local d = r.Position - jetPos
				local dist = d.Magnitude
				if dist < range and dist > 20 then
					local ang = math.acos(math.clamp(ctrl.LookVector:Dot(d.Unit), -1, 1))
					if ang < cone and (not bestAng or ang < bestAng) then best, bestAng = r, ang end
				end
			end
		end
	end
	return best
end

local function takeOrd(kind)
	for pass = 1, 2 do
		for _, o in ipairs(ordList) do
			if o.kind == kind and o.inst and o.inst.Parent then
				local side = o.lat >= 0 and 1 or -1
				if side == bombSide or pass == 2 then
					bombSide = -bombSide
					local inst = o.inst
					o.inst = nil
					local cf = inst:GetPivot()
					inst.Parent = fx
					return {obj = inst, isModel = true, pos = cf.Position, rot0 = cf.Rotation}
				end
			end
		end
	end
	if kindTotal(kind) == 0 and (fallback[kind] or 0) > 0 then
		fallback[kind] -= 1
		bombSide = -bombSide
		local len = kind == "bomb" and 4 or 6
		local th = kind == "bomb" and 1.3 or 0.9
		local part = mk("Part", {
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, th, th), Anchored = true,
			CanCollide = false, CanQuery = false, CanTouch = false, Material = Enum.Material.Metal,
			Color = kind == "bomb" and Color3.fromRGB(70, 78, 50) or Color3.fromRGB(200, 200, 205),
		}, fx)
		return {obj = part, isModel = false, pos = jetPos + ctrl:VectorToWorldSpace(Vector3.new(bombSide * 4, -2.5, 0))}
	end
	return nil
end

local function launch(kind)
	if not flying or os.clock() - lastBomb < 0.4 then return end
	local spec = takeOrd(kind)
	if not spec then
		say(tr("h_noammo", tr(WKEY[weapon])), 1.5)
		return
	end
	lastBomb = os.clock()
	local look = ctrl.LookVector
	local p = {
		obj = spec.obj, isModel = spec.isModel, pos = spec.pos, rot0 = spec.rot0 or CFrame.new(),
		d0 = look, t = 0, kind = kind,
	}
	if kind == "bomb" then
		p.sub = BOMB_TYPES[bombSub]
		p.vel = look * speed
		if p.sub == "JDAM" or p.sub == "Paveway" then p.tgtPos = boresightPoint() end
	elseif kind == "agm" then
		p.spd = math.max(speed, 150)
		p.vel = look * p.spd
		p.tgtPos = boresightPoint()
		addTrail(spec.obj)
	else
		p.sub = AAM_TYPES[aamSub]
		p.maxSpd = p.sub == "AIM-120" and 800 or 650
		p.turn = p.sub == "AIM-120" and 2.2 or 3.0
		p.spd = math.max(speed, 200)
		p.vel = look * p.spd
		p.tgt = findTarget(p.sub)
		addTrail(spec.obj)
	end
	table.insert(projectiles, p)
end

local function detonate(b, pos)
	if b.kind == "bomb" then
		if b.sub == "Mk84" then
			explode(pos, 40, 90, 3)
		else
			explode(pos, b.sub == "Paveway" and 25 or 20, 45, 1.5)
		end
	elseif b.kind == "agm" then
		explode(pos, 16, 32, 2)
	else
		explode(pos, 10, 24, 1)
		fragRing(pos, b.vel.Magnitude > 1 and b.vel.Unit or Vector3.zAxis)
	end
end

local function stepProjectile(b, i, dt)
	b.t += dt
	local boom = false
	local g = Vector3.new(0, -workspace.Gravity, 0)
	if b.kind == "bomb" then
		local tp = b.tgtPos
		if b.sub == "Paveway" and flying then
			tp = boresightPoint() or tp
			b.tgtPos = tp
		end
		b.vel += g * dt
		if tp then
			local d = tp - b.pos
			if d.Magnitude > 2 then b.vel = b.vel:Lerp(d.Unit * b.vel.Magnitude, math.min(1, dt * 1.2)) end
		end
	elseif b.kind == "agm" then
		if b.t < 8 then
			b.spd = math.min(b.spd + 300 * dt, 450)
			local dir = b.vel.Unit
			if b.tgtPos then
				local d = b.tgtPos - b.pos
				if d.Magnitude > 2 then dir = dir:Lerp(d.Unit, math.min(1, dt * 2.5)).Unit end
			end
			b.vel = dir * b.spd
		else
			b.vel += g * dt
		end
	else
		b.spd = math.min(b.spd + 400 * dt, b.maxSpd)
		local dir = b.vel.Unit
		local tgt = b.tgt
		if tgt and tgt.Parent then
			local d = tgt.Position - b.pos
			if d.Magnitude < 14 then
				boom = true
			else
				dir = dir:Lerp(d.Unit, math.min(1, b.turn * dt)).Unit
			end
		end
		b.vel = dir * b.spd
		if b.t > 10 then boom = true end
	end

	local newPos = b.pos + b.vel * dt
	local res = workspace:Raycast(b.pos, newPos - b.pos, bombRP)
	if boom or res then
		detonate(b, res and res.Position or b.pos)
		b.obj:Destroy()
		table.remove(projectiles, i)
	elseif b.t > 15 or newPos.Y < -500 then
		b.obj:Destroy()
		table.remove(projectiles, i)
	else
		b.pos = newPos
		if b.isModel then
			b.obj:PivotTo(CFrame.new(newPos) * modelOrient(b))
		else
			b.obj.CFrame = orient(newPos, b.vel)
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	for i = #projectiles, 1, -1 do
		local b = projectiles[i]
		if not b.obj.Parent then
			table.remove(projectiles, i)
		else
			stepProjectile(b, i, dt)
		end
	end
end)

