local function beginFlight(char, hrp, hum)
	rp.FilterDescendantsInstances = {jet, char}
	bombRP.FilterDescendantsInstances = {jet, char, fx}
	hrp.Anchored = true
	if hum then hum.AutoRotate = false end
	setControls(false)
	camMode, camYaw, camPitch = "FREE", 0, 0
	camLook, camUpV = ctrl.LookVector, Vector3.yAxis
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = camFov
	horizonBox.Visible, cross.Visible = true, true
	if not engSnd.IsPlaying then engSnd:Play() end
	flying = true
	ui()
end

local function leaveChar()
	engSnd:Stop()
	firing = false
	for k in pairs(hold) do hold[k] = false end
	resetNearHide()
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
	horizonBox.Visible, cross.Visible = false, false
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if char then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
		end
	end
	if hum then hum.Sit = false hum.AutoRotate = true end
	setControls(true)
	return char and char:FindFirstChild("HumanoidRootPart")
end

