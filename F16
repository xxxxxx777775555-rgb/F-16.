local function setControls(on)
	pcall(function()
		local c = require(player.PlayerScripts:WaitForChild("PlayerModule")):GetControls()
		if on then c:Enable() else c:Disable() end
	end)
end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function partCount(inst)
	local c = cntCache[inst]
	if c then return c end
	c = inst:IsA("BasePart") and 1 or 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then c += 1 end
	end
	cntCache[inst] = c
	return c
end

local function wordIn(name, words)
	local n = name:lower()
	for _, w in ipairs(words) do
		if n:find(w, 1, true) then return true end
	end
	return false
end

local function nameHit(inst, root, words, cap)
	local x = inst
	while x and x ~= root do
		if (x == inst or partCount(x) <= cap) and wordIn(x.Name, words) then return true end
		x = x.Parent
	end
	return false
end

local function partsOf(inst)
	local t = {}
	if inst:IsA("BasePart") then table.insert(t, inst) end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(t, d) end
	end
	return t
end

local function latAxis()
	return (math.abs(fwdAxis.X) > 0.5) and Vector3.zAxis or Vector3.xAxis
end

-- ===== ห้องนักบิน =====
local function calibrate(model)
	local pivot = model:GetPivot()
	local bbCF = model:GetBoundingBox()
	local center = pivot:PointToObjectSpace(bbCF.Position)

	local best, bestScore
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			local n = p.Name:lower()
			local nHit = n:find("canopy") or n:find("glass") or n:find("cockpit") or n:find("windshield") or n:find("window")
			local glassy = p.Material == Enum.Material.Glass or (p.Transparency > 0.15 and p.Transparency < 0.98)
			if nHit or glassy then
				local score = p.Size.X * p.Size.Y * p.Size.Z * (nHit and 4 or 1)
				if not bestScore or score > bestScore then best, bestScore = p, score end
			end
		end
	end
	if not best then return nil end

	local c = pivot:PointToObjectSpace(best.Position)
	local d = c - center
	if math.abs(d.X) < 0.5 and math.abs(d.Z) < 0.5 then return nil end

	local f
	if math.abs(d.X) > math.abs(d.Z) then
		f = Vector3.new(d.X > 0 and 1 or -1, 0, 0)
	else
		f = Vector3.new(0, 0, d.Z > 0 and 1 or -1)
	end
	return math.deg(math.atan2(f.X, -f.Z)), c + Vector3.new(0, -1.2, 0), best.Name, f, best
end

-- ===== ล้อ (แยก 3 ชุด: ล้อหน้า / ล้อหลักซ้าย / ล้อหลักขวา) + ฝาช่องล้อ =====
local function addGear(p, model)
	if gearSet[p] or doorSet[p] or ordPartSet[p] then return end
	gearSet[p] = true
	table.insert(gearParts, {part = p, rel = model:GetPivot():ToObjectSpace(p.CFrame), t = p.Transparency})
end

local function removeGear(p)
	if not gearSet[p] then return end
	gearSet[p] = nil
	for i = #gearParts, 1, -1 do
		if gearParts[i].part == p then
			p.Transparency = gearParts[i].t
			table.remove(gearParts, i)
		end
	end
end

local function removeDoor(p)
	if not doorSet[p] then return end
	doorSet[p] = nil
	for i = #doorParts, 1, -1 do
		if doorParts[i].part == p then table.remove(doorParts, i) end
	end
end

local function cornersMinMaxY(rel, size)
	local lo, hi = math.huge, -math.huge
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			for sz2 = -1, 1, 2 do
				local y = (rel * Vector3.new(sx * size.X / 2, sy * size.Y / 2, sz2 * size.Z / 2)).Y
				lo, hi = math.min(lo, y), math.max(hi, y)
			end
		end
	end
	return lo, hi
end

local function rebuildClusters()
	local L = latAxis()
	local cLat = centerOff:Dot(L)
	local thr = jetDiag * 0.04
	local units = {
		nose = {parts = {}, delay = 0},
		left = {parts = {}, delay = 0.06},
		right = {parts = {}, delay = 0.12},
	}
	for _, g in ipairs(gearParts) do
		local lat = g.rel.Position:Dot(L) - cLat
		local u = (lat < -thr) and units.left or ((lat > thr) and units.right or units.nose)
		table.insert(u.parts, g)
	end
	local ang = math.rad(GEAR_FOLD)
	local lowest = math.huge
	for name, u in pairs(units) do
		if #u.parts > 0 then
			local maxY, sum = -math.huge, Vector3.zero
			for _, g in ipairs(u.parts) do
				local lo, hi = cornersMinMaxY(g.rel, g.part.Size)
				lowest = math.min(lowest, lo)
				maxY = math.max(maxY, hi)
				sum += g.rel.Position
			end
			local C = sum / #u.parts
			local H = C + Vector3.yAxis * (maxY - C.Y)
			local axis, sign
			if name == "nose" then
				axis = L
				local function back(s)
					return (H + CFrame.fromAxisAngle(axis, s * ang):VectorToWorldSpace(C - H) - C):Dot(fwdAxis)
				end
				sign = (back(1) < back(-1)) and 1 or -1
			else
				axis = fwdAxis
				local function toward(s)
					return math.abs((H + CFrame.fromAxisAngle(axis, s * ang):VectorToWorldSpace(C - H)):Dot(L) - cLat)
				end
				sign = (toward(1) <= toward(-1)) and 1 or -1
			end
			u.hinge, u.axis, u.sign = H, axis, sign
			for _, g in ipairs(u.parts) do g.cluster = u end
		end
	end
	-- ความสูงตอนล้อแตะพื้น: จากจุดต่ำสุดของล้อจริง
	local half = jetSizeY * 0.5
	local fromWheel = (#gearParts > 0 and lowest < math.huge) and (centerOff.Y - lowest) or half
	gearH = math.max(math.max(fromWheel, half * 0.85) + GEAR_ADJUST, 3)
end

local function addDoor(p, model, inboard)
	if ordPartSet[p] then return end
	removeGear(p)
	if doorSet[p] then return end
	local rel = model:GetPivot():ToObjectSpace(p.CFrame)
	local sz = p.Size
	local F = fwdAxis
	local L = latAxis()
	local cLat = centerOff:Dot(L)
	local C = rel.Position

	local maxY = -math.huge
	local bestLat, bestDist = C:Dot(L), inboard and math.huge or -1
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			for sz2 = -1, 1, 2 do
				local corner = rel * Vector3.new(sx * sz.X / 2, sy * sz.Y / 2, sz2 * sz.Z / 2)
				maxY = math.max(maxY, corner.Y)
				local lat = corner:Dot(L)
				local dist = math.abs(lat - cLat)
				if (inboard and dist < bestDist) or ((not inboard) and dist > bestDist) then
					bestDist, bestLat = dist, lat
				end
			end
		end
	end
	local H = C + L * (bestLat - C:Dot(L)) + Vector3.yAxis * (maxY - C.Y)
	local ang = math.rad(DOOR_ANGLE)
	local function latAfter(s)
		local v = CFrame.fromAxisAngle(F, s * ang):VectorToWorldSpace(C - H)
		return math.abs((H + v):Dot(L) - cLat)
	end
	local sign = (latAfter(1) <= latAfter(-1)) and 1 or -1
	sign *= DOOR_FLIP

	doorSet[p] = true
	table.insert(doorParts, {part = p, rel = rel, hinge = H, axis = F, sign = sign})
end

-- ลำดับ: ล้อพับ (s 0 → 0.5, แต่ละชุดเริ่มไม่พร้อมกัน) แล้วหาย → ฝาช่องล้อหุบ (s 0.55 → 0.95)
local function applyGear(pivotCF)
	local s = gearAnim
	if s > 0 then
		local lift = gearH * 0.2
		for _, g in ipairs(gearParts) do
			local p, c = g.part, g.cluster
			if p.Parent and c then
				local u = smooth((s - c.delay) / 0.5)
				local fade = smooth((u - 0.55) / 0.3)
				p.CFrame = pivotCF * CFrame.new(0, lift * u, 0) * CFrame.new(c.hinge)
					* CFrame.fromAxisAngle(c.axis, c.sign * math.rad(GEAR_FOLD) * u)
					* CFrame.new(-c.hinge) * g.rel
				p.Transparency = g.t + (1 - g.t) * fade
			end
		end
	elseif lastS > 0 then
		for _, g in ipairs(gearParts) do
			if g.part.Parent then g.part.Transparency = g.t end
		end
	end
	lastS = s

	local ed = smooth((s - 0.55) / 0.4)
	if ed > 0 or lastEd > 0 then
		for _, d in ipairs(doorParts) do
			local p = d.part
			if p.Parent then
				p.CFrame = pivotCF * CFrame.new(d.hinge)
					* CFrame.fromAxisAngle(d.axis, d.sign * math.rad(DOOR_ANGLE) * ed)
					* CFrame.new(-d.hinge) * d.rel
			end
		end
	end
	lastEd = ed
end

