local function explode(pos, radius, ballSize, shakeMul)
	local ex = Instance.new("Explosion")
	ex.Position = pos
	ex.BlastRadius = radius
	ex.BlastPressure = 0
	ex.DestroyJointRadiusPercent = 0
	ex.ExplosionType = Enum.ExplosionType.NoCraters
	ex.Parent = workspace

	local ball = mk("Part", {
		Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), Position = pos, Anchored = true,
		CanCollide = false, CanQuery = false, CanTouch = false, Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 140, 30),
	}, fx)
	mk("PointLight", {Range = 60, Brightness = 6, Color = Color3.fromRGB(255, 160, 60)}, ball)
	local snd = mk("Sound", {SoundId = "rbxasset://sounds/impact_explosion_03.mp3", Volume = 2, RollOffMaxDistance = 500}, ball)
	snd:Play()
	TweenService:Create(ball, TweenInfo.new(0.7), {Size = Vector3.new(ballSize, ballSize, ballSize), Transparency = 1}):Play()
	Debris:AddItem(ball, 3)

	local dist = (pos - cam.CFrame.Position).Magnitude
	shake = math.max(shake, math.clamp(1 - dist / 250, 0, 1) * 1.5 * shakeMul)
end

local function fragRing(pos, dir)
	local right = dir:Cross(Vector3.yAxis)
	if right.Magnitude < 0.1 then right = Vector3.xAxis end
	right = right.Unit
	local up = right:Cross(dir).Unit
	for i = 1, 24 do
		local a = i / 24 * math.pi * 2
		local d = right * math.cos(a) + up * math.sin(a)
		local s = mk("Part", {
			Size = Vector3.new(0.3, 0.3, 1.2), Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
			Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 220, 120), CFrame = CFrame.lookAt(pos, pos + d),
		}, fx)
		TweenService:Create(s, TweenInfo.new(0.5), {CFrame = CFrame.lookAt(pos + d * 35, pos + d * 36), Transparency = 1}):Play()
		Debris:AddItem(s, 0.7)
	end
end

local function orient(pos, dir)
	local up = math.abs(dir.Unit.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
	return CFrame.lookAt(pos, pos + dir, up) * CFrame.Angles(0, math.rad(90), 0)
end

local function modelOrient(b)
	local v = b.vel
	if v.Magnitude < 1 then return b.rot0 end
	local d = v.Unit
	local axis = b.d0:Cross(d)
	local ang = math.acos(math.clamp(b.d0:Dot(d), -1, 1))
	local delta = axis.Magnitude > 1e-4 and CFrame.fromAxisAngle(axis.Unit, ang) or CFrame.new()
	return delta * b.rot0
end

local function addTrail(obj)
	local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
	if not part then return end
	mk("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/smoke_main.dds", Rate = 60, Lifetime = NumberRange.new(1, 1.6),
		Speed = NumberRange.new(0, 1), Color = ColorSequence.new(Color3.fromRGB(210, 210, 210)),
		Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5)}),
		Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1)}),
	}, part)
end

