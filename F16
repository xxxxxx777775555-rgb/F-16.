local function isPress(i)
	return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
end

-- key = คีย์ภาษา (string) หรือ function คืนข้อความ
local function button(parent, key, x, y, w, h, cb, colorFn)
	local textFn = type(key) == "function" and key or function() return tr(key) end
	local b = mk("TextButton", {
		Text = "", Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = BG, BackgroundTransparency = 0.12, TextColor3 = TXT,
		Font = Enum.Font.GothamMedium, TextScaled = true, BorderSizePixel = 0, AutoButtonColor = true,
	}, parent)
	mk("UICorner", {CornerRadius = UDim.new(0, 5)}, b)
	mk("UIStroke", {Color = EDGE, Thickness = 1.2}, b)
	mk("UITextSizeConstraint", {MaxTextSize = 14, MinTextSize = 8}, b)
	mk("UIPadding", {PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)}, b)
	if cb then b.Activated:Connect(cb) end
	table.insert(registry, {obj = b, text = textFn, color = colorFn})
	return b
end

local function bindDrag(frame, onUpdate)
	local active
	frame.InputBegan:Connect(function(i)
		if isPress(i) then
			active = i
			onUpdate(i.Position)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if active and (i == active or (active.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement)) then
			onUpdate(i.Position)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i == active then active = nil end
	end)
end

